<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GorselProgOdev3.NewsPage"
             Title="Haber Sayfası">
    <StackLayout Padding="20">
        <Picker Margin="10" x:Name="KategoriPicker" Title="Kategori Seç" />
        <Button Margin="10" Text="Haberleri Getir" Clicked="GetNewsButton_Clicked" />
        <ListView x:Name="HaberListView">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <StackLayout Orientation="Vertical" Padding="10">
                            <!-- Haber Başlığı -->
                            <Label Text="{Binding Title}" FontAttributes="Bold" />

                            <!-- Yayın Tarihi -->
                            <Label Text="{Binding PubDate}" FontSize="Small" TextColor="Gray" />

                            <!-- Haber Resmi -->
                            <Image Source="{Binding ImageUrl}" Aspect="AspectFit" HeightRequest="200" />

                            <!-- Haber Açıklaması -->
                            <Label Text="{Binding CleanDescription}" LineBreakMode="WordWrap" />
                        </StackLayout>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackLayout>
    
</ContentPage>