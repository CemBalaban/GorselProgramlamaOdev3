<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GorselProgOdev3.AuthPage"
             Title="Giriş Sayfası">
    <StackLayout Padding="20">
        <Entry x:Name="EmailEntry" Placeholder="Email" Keyboard="Email"/>
        <Entry x:Name="PasswordEntry" Placeholder="Şifre" IsPassword="True"/>
        <Button Text="Giriş Yap" Clicked="LoginButton_Clicked" Margin="5" Padding="20"/>
        <Button Text="Kayıt Ol" Clicked="RegisterButton_Clicked" Margin="5" Padding="20"/>
        <Label x:Name="StatusLabel" TextColor="Red" />
    </StackLayout>
</ContentPage>