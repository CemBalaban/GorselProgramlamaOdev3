<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GorselProgOdev3.CurrencyPage"
             Title="Döviz Kurları">
    <StackLayout Padding="10">
        <Button Text="Kurları Getir" Clicked="GetRatesButton_Clicked" />
        <CollectionView x:Name="CurrencyCollectionView" Margin="0,10,0,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10" ColumnDefinitions="*,*,*,*,*">
                        <!-- Döviz Türü -->
                        <Label Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold" />
                        <!-- Alış Fiyatı -->
                        <Label Grid.Column="1" Text="{Binding Buying}" />
                        <!-- Satış Fiyatı -->
                        <Label Grid.Column="2" Text="{Binding Selling}" />
                        <!-- Değişim -->
                        <Label Grid.Column="3" Text="{Binding Change}" />
                        <!-- Değişim Yönü -->
                        <Image Grid.Column="4" Source="{Binding DirectionIcon}" HeightRequest="20" WidthRequest="20" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </StackLayout>
</ContentPage>